# Server-only. Copy to .env.local; never commit real values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Non-secret public display settings only. Never put an API key in NEXT_PUBLIC_*.
NEXT_PUBLIC_APP_NAME=Clinora AI
NEXT_PUBLIC_DEFAULT_EMERGENCY_NUMBER=

# Optional: disable Next.js build-tool telemetry (not application analytics).
NEXT_TELEMETRY_DISABLED=1
